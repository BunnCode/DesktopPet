<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin Win32 adapter: turns the real desktop into Core snapshots. No game rules here. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopPet.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Interop\NativeMethods.txt" />
    <AdditionalFiles Include="Interop\NativeMethods.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopPet.Core\DesktopPet.Core.csproj" />
  </ItemGroup>

</Project>
