<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF composition root: windows, rendering, menus, tray. Wires Platform.Windows into Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 wants WinForms' SetHighDpiMode instead of the manifest. This is a WPF app (WinForms is only
         the tray icon) and the manifest is what makes the whole process PerMonitorV2 before any window exists. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- WinForms implicit usings clash with WPF types (Application, Image, ...); import them explicitly where needed. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The built-in characters: the default ones (regenerate with tools/sprites/make_character.py) and the rabbit
       (tools/sprites/make_rabbit.py). New pets get a copy of their character's sheet in their own sprites folder. -->
  <ItemGroup>
    <EmbeddedResource Include="SpriteSheet\rabbit.png" LogicalName="Deskling.App.rabbit.png" />
    <EmbeddedResource Include="SpriteSheet\Fakemon\*.png" LogicalName="Deskling.App.Characters.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The default furniture art, copied into the furniture folder on first run. Also generated by make_rabbit.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Furniture\Art\*.png" LogicalName="Deskling.App.Furniture.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The chat model (tools/models/get-model.ps1 downloads it into models\ at the repo root). It goes in a models\
       folder next to the exe, never inside the single-file exe, which would have to unpack 1.5 GB on every start.
       Hard links where possible, so a build doesn't take another copy's worth of disk. -->
  <PropertyGroup>
    <CreateHardLinksForAdditionalFilesIfPossible>true</CreateHardLinksForAdditionalFilesIfPossible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\models\*.gguf" Link="models\%(Filename)%(Extension)" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <!-- LLamaSharp looks for its native DLLs in runtimes\win-x64\native\<variant>\ next to the exe. Bundled into a
       single-file exe they'd be unpacked to a temp folder it never searches, and chat would stay off. -->
  <Target Name="KeepLlamaNativesBesideTheExe" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Deskling.Chat\Deskling.Chat.csproj" />
    <ProjectReference Include="..\Deskling.Core\Deskling.Core.csproj" />
    <ProjectReference Include="..\Deskling.Platform.Windows\Deskling.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
